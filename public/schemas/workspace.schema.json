        "analystId": {
          "type": [
            "string",
            "null"
          ],
          "x-references": "actors"
        },
        "qaReviewerId": {
          "type": [
            "string",
            "null"
          ],
          "x-references": "actors"
        },
        "decisionOwnerId": {
          "type": [
            "string",
            "null"
