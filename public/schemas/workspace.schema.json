      "type": "array",
      "items": {
        "$ref": "#/$defs/requirementReviews"
      }
    },
    "documentVersions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/documentVersions"
      }
    },
    "evidenceCitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceCitations"
      }
